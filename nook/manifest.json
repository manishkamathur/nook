{
  "manifest_version": 3,
  "name": "Nook: quiet tab archive",
  "short_name": "Nook",
  "version": "0.1.1",
  "description": "Quietly rests tabs you haven't looked at, asks why each was open, and sorts them so you can find them again.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nook",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "contextMenus",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "archive-tab": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Rest this tab in Nook"
    },
    "open-sort": {
      "description": "Open the sorting screen"
    }
  },
  "incognito": "not_allowed"
}
